# Django
DJANGO_SECRET_KEY=change-me-in-production
TIME_ZONE=Asia/Qyzylorda

# terminal | whatsapp | whatsapp_test
BOT_TRANSPORT=terminal
DJANGO_DEBUG=False

# ngrok: токен из личного кабинета https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok-free.dev

# AI-анализ свободных ответов. Без ключа бот принимает нумерованные ответы
# или по одному ответу на строку.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_CALLBACK_URL=https://your-domain.example/webhooks/whatsapp/
WHATSAPP_API_VERSION=v23.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# Register WHATSAPP_WEBHOOK_CALLBACK_URL in Meta after switching to WhatsApp.
